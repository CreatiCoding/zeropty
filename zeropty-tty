#!/bin/sh
# Runs a program with the session's pipes in place of a terminal: shim.dylib answers isatty, tcgetattr,
# TIOCGWINSZ, tcgetpgrp and /dev/tty for it. macOS drops DYLD_INSERT_LIBRARIES for SIP-protected
# binaries (/usr/bin, /bin, /sbin, /System) and for ones signed with the hardened runtime: those run from
# an ad-hoc signed copy, refreshed whenever the original changes (an update). A copy has none of the
# original's privileges (setuid, entitlements): top or ps do not run that way. A script's interpreter
# behind /usr/bin/env loses the shim too (SIP clears DYLD_* there); run the interpreter itself instead.
# usage: zeropty-tty program [args...]   e.g. zeropty new-session -d -s v "zeropty-tty vim notes.txt"
set -e
HERE=$(cd "$(dirname "$0")" && pwd)
[ $# -ge 1 ] || { echo "usage: zeropty-tty program [args...]" >&2; exit 2; }
PROG=$1; shift
case $PROG in
  */*) ;;
  *) PROG=$(command -v "$PROG") || { echo "zeropty-tty: $PROG: not found" >&2; exit 127; } ;;
esac
REAL=$(realpath "$PROG")
# Run by the name it was given (a link's, not its target's): ps and pgrep look for that name.
RUN=$PROG
copy=no
case $REAL in
  /usr/local/*) ;;
  /usr/*|/bin/*|/sbin/*|/System/*) copy=yes ;;
esac
CACHE=${ZEROPTY_CACHE:-$HOME/.zeropty}/tty
# A copy, too, goes by the name it was run by, not its target's (claude's is claude.exe): ps and pgrep
# look for that name, and some programs go by it (/usr/bin/python3 asks xcode-select for the tool it
# names). The directory follows the target, so each name of one program gets its own copy there; the
# stamps saying which original a copy was made from live apart, so no name can be another's stamp.
DIR=$CACHE/$(printf %s "$REAL" | shasum | cut -c1-12)
NAME=$(basename "$PROG")
COPY=$DIR/bin/$NAME
STAMP=$DIR/src/$NAME
SRC="$REAL $(stat -f '%m %z' "$REAL")"
if [ $copy = no ] && [ "$(cat "$STAMP" 2>/dev/null)" != "$SRC" ]; then
  # The hardened runtime shows in the signature's flags; checked once per version of the program.
  codesign -dv "$REAL" 2>&1 | grep -q 'flags=.*runtime' && copy=yes
fi
[ -x "$COPY" ] && [ "$(cat "$STAMP" 2>/dev/null)" = "$SRC" ] && copy=yes
if [ $copy = yes ]; then
  if [ ! -x "$COPY" ] || [ "$(cat "$STAMP" 2>/dev/null)" != "$SRC" ]; then
    mkdir -p "$DIR/bin" "$DIR/src"
    # Built next to the final path and renamed, so concurrent sessions never see a half-written binary.
    TMP=$DIR/tmp.$$
    cp "$REAL" "$TMP" && codesign --force -s - "$TMP" 2>/dev/null && mv -f "$TMP" "$COPY" && echo "$SRC" > "$STAMP"
  fi
  RUN=$COPY
fi
DYLD_INSERT_LIBRARIES=${ZEROPTY_SHIM:-$HERE/shim.dylib} exec "$RUN" "$@"
